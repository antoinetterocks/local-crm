{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Artology CRM",
  "version": "0.1.0",
  "identifier": "live.artology.crm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "title": "Artology CRM",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Artology CRM",
    "longDescription": "Sources, contacts, organizations and follow-ups for galleries and artists."
  }
}
